<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Incident Report #{{ incident.id }} — {{ incident.title }}</title>
<style>
  @media print { body { margin: 0; } .no-print { display: none; } }
  :root {
    --ink: #1b2230; --muted: #5b6478; --line: #dde2ea; --paper: #ffffff; --paper-2: #f5f7fa;
    --critical: #c8283f; --high: #c1631f; --medium: #91721a; --low: #1d5fae;
    --accent: #0f8a5f;
  }
  * { box-sizing: border-box; }
  body {
    font-family: 'IBM Plex Sans', -apple-system, Segoe UI, Helvetica, Arial, sans-serif;
    color: var(--ink); background: var(--paper-2); margin: 0; padding: 40px 20px;
    line-height: 1.55; font-size: 15px;
  }
  main { max-width: 840px; margin: 0 auto; background: var(--paper); border: 1px solid var(--line); padding: 48px 56px; }
  code, .mono, td.mono, .ip { font-family: 'IBM Plex Mono', 'SFMono-Regular', Consolas, monospace; font-size: 0.93em; }
  h1 { font-size: 22px; margin: 0 0 4px; }
  h2 { font-size: 15px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted);
       border-bottom: 1px solid var(--line); padding-bottom: 8px; margin: 36px 0 16px; }
  h3 { font-size: 15px; margin: 20px 0 6px; }
  .kicker { font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: var(--accent); letter-spacing: 0.08em; text-transform: uppercase; }
  table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
  .meta-table td { padding: 6px 0; border-bottom: 1px solid var(--line); }
  .meta-table td:first-child { color: var(--muted); width: 180px; }
  .events-table th, .events-table td { text-align: left; padding: 7px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .events-table th { color: var(--muted); font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; }
  .badge { display: inline-block; padding: 2px 9px; border-radius: 3px; font-size: 11.5px; font-weight: 600;
           font-family: 'IBM Plex Mono', monospace; letter-spacing: 0.03em; color: #fff; }
  .sev-CRITICAL { background: var(--critical); }
  .sev-HIGH { background: var(--high); }
  .sev-MEDIUM { background: var(--medium); }
  .sev-LOW { background: var(--low); }
  .alert-card { border: 1px solid var(--line); border-left: 4px solid var(--muted); padding: 12px 16px; margin-bottom: 14px; background: var(--paper-2); }
  .alert-card.sev-border-CRITICAL { border-left-color: var(--critical); }
  .alert-card.sev-border-HIGH { border-left-color: var(--high); }
  .alert-card.sev-border-MEDIUM { border-left-color: var(--medium); }
  .alert-card.sev-border-LOW { border-left-color: var(--low); }
  .alert-meta { color: var(--muted); font-size: 12.5px; margin: 4px 0; }
  ul.notes, ul.remediation { padding-left: 20px; margin: 8px 0; }
  ul.notes li, ul.remediation li { margin-bottom: 6px; }
  footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--line); color: var(--muted); font-size: 12px; }
</style>
</head>
<body>
<main>
  <div class="kicker">Mini-SOC &middot; Incident Report</div>
  <h1>{{ incident.title }}</h1>
  <p class="alert-meta">Incident #{{ incident.id }} &middot; generated {{ generated_at }}</p>

  <table class="meta-table">
    <tr><td>Severity</td><td><span class="badge sev-{{ incident.severity }}">{{ incident.severity }}</span></td></tr>
    <tr><td>Status</td><td>{{ incident.status }}</td></tr>
    <tr><td>Assigned to</td><td>{{ incident.assigned_to or "Unassigned" }}</td></tr>
    <tr><td>Opened</td><td class="mono">{{ incident.created_at }}</td></tr>
    <tr><td>Closed</td><td class="mono">{{ incident.closed_at or "—" }}</td></tr>
  </table>

  <h2>Executive Summary</h2>
  <p>{{ incident.description | replace("\n", "<br>") | safe }}</p>
  {% if incident.resolution %}<p><strong>Resolution:</strong> {{ incident.resolution }}</p>{% endif %}

  <h2>Indicators of Compromise</h2>
  <table class="meta-table">
    <tr><td>Source IP(s)</td><td class="mono">{{ indicators.ips | join(", ") if indicators.ips else "None recorded" }}</td></tr>
    <tr><td>User account(s)</td><td class="mono">{{ indicators.users | join(", ") if indicators.users else "None recorded" }}</td></tr>
    <tr><td>Affected host(s)</td><td class="mono">{{ indicators.hosts | join(", ") if indicators.hosts else "None recorded" }}</td></tr>
  </table>

  <h2>Linked Alerts ({{ alerts | length }})</h2>
  {% for alert in alerts %}
  <div class="alert-card sev-border-{{ alert.severity }}">
    <strong>#{{ alert.id }} — {{ alert.title }}</strong>
    <span class="badge sev-{{ alert.severity }}">{{ alert.severity }}</span>
    <div class="alert-meta">
      Rule <code>{{ alert.rule_name }}</code> &middot; Status {{ alert.status }} &middot;
      Source IP <span class="mono">{{ alert.source_ip or "—" }}</span> &middot;
      User <span class="mono">{{ alert.user or "—" }}</span> &middot;
      Host <span class="mono">{{ alert.host or "—" }}</span> &middot;
      {{ alert.event_count }} event(s)
    </div>
    <div>{{ alert.description }}</div>
  </div>
  {% endfor %}

  <h2>Event Timeline ({{ events | length }})</h2>
  <table class="events-table">
    <thead><tr><th>Timestamp</th><th>Type</th><th>Source IP</th><th>User</th><th>Host</th><th>Description</th></tr></thead>
    <tbody>
    {% for e in events %}
      <tr>
        <td class="mono">{{ e.timestamp }}</td>
        <td>{{ e.event_type }}</td>
        <td class="mono">{{ e.source_ip or "—" }}</td>
        <td class="mono">{{ e.user or "—" }}</td>
        <td>{{ e.host }}</td>
        <td>{{ e.description or "" }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>

  <h2>Analyst Notes</h2>
  <ul class="notes">
    {% for n in notes %}<li><span class="mono">{{ n.created_at }}</span> ({{ n.author }}) — {{ n.note }}</li>{% endfor %}
  </ul>

  <h2>Recommended Remediation</h2>
  <ul class="remediation">
    {% for step in remediation %}<li>{{ step }}</li>{% endfor %}
  </ul>

  <footer>Generated by Mini-SOC from locally collected log data. Verify all indicators before taking action.</footer>
</main>
</body>
</html>
